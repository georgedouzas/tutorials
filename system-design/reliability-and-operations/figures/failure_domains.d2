...@../../../_filters/d2-theme

region: "Region" {
  label.near: bottom-center
  grid-columns: 2
  grid-gap: 24
  za: "Zone A" {
    label.near: bottom-center
    grid-columns: 2
    grid-gap: 16
    r1: "Rack 1" {
      grid-rows: 2
      grid-gap: 10
      h1: "Host"
      h2: "Host"
    }
    r2: "Rack 2" {
      grid-rows: 2
      grid-gap: 10
      h3: "Host"
      h4: "Host"
    }
  }
  zb: "Zone B" {
    label.near: bottom-center
    grid-columns: 2
    grid-gap: 16
    r3: "Rack 3" {
      grid-rows: 2
      grid-gap: 10
      h5: "Host"
      h6: "Host"
    }
    r4: "Rack 4" {
      grid-rows: 2
      grid-gap: 10
      h7: "Host"
      h8: "Host"
    }
  }
}
