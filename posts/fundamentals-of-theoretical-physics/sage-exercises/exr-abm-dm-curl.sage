# Exercise exr-abm-dm-curl: the monopole potentials A_N = g(-y, x, 0)/(4 pi r (r + z)) and A_S = -g(-y, x, 0)/(4 pi r (r - z))
# both have curl g x/(4 pi r^3) away from their strings, and A_N - A_S = grad(g phi/2pi) = g(-y, x, 0)/(2 pi (x^2 + y^2)).
x, y, z, g = var("x y z g", domain="real")
r = sqrt(x^2 + y^2 + z^2)
AN = vector([-y, x, 0]) * g / (4 * pi * r * (r + z))
AS = -vector([-y, x, 0]) * g / (4 * pi * r * (r - z))
curl = lambda A: vector([diff(A[2], y) - diff(A[1], z), diff(A[0], z) - diff(A[2], x), diff(A[1], x) - diff(A[0], y)])
Bmon = g * vector([x, y, z]) / (4 * pi * r^3)
print("[PASS] curl A_N = B:", all((c - b).simplify_full() == 0 for c, b in zip(curl(AN), Bmon)))
print("[PASS] curl A_S = B:", all((c - b).simplify_full() == 0 for c, b in zip(curl(AS), Bmon)))
lam = g * atan2(y, x) / (2 * pi)
grad = vector([diff(lam, x), diff(lam, y), diff(lam, z)])
print("[PASS] A_N - A_S = grad(g phi / 2 pi):", all((a - b).simplify_full() == 0 for a, b in zip(AN - AS, grad)))
print("[PASS] div B = 0 away from the origin:", bool((sum(diff(Bmon[i], v) for i, v in enumerate((x, y, z)))).simplify_full() == 0))
